# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Secrets and local config
.env

# Generated book data (PDFs, plans, scripts, renders). Keep the folder, not the contents.
data/books/*
!data/books/.gitkeep
data/auditions/
data/jobs.sqlite*

# Voice references and stings are personal audio, never committed.
cast/refs/*
!cast/refs/.gitkeep
cast/stings/*
!cast/stings/.gitkeep

# Same reason: the reaction bank is cloned from those references, and the
# candidate pool is throwaway renders of them.
cast/reactions/

# Appended after every episode: per-user state, and full of book content.
cast/continuity.jsonl

# Editor
.vscode/
.idea/
*.swp
.DS_Store
