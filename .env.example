# Copy to .env and fill in. Every variable is optional; unset ones fall back to defaults.

# Keep all book content on your own machine. With this on: the OpenCode server must be a local
# address and Hugging Face runs from its local cache only.
STUDIEPODCAST_OFFLINE=0

# Quality over speed: 1 for an unhurried run. Raises the four writing passes (plan review rounds,
# plan part chars, revise rounds, OpenCode timeout) to what a run that may take all night should
# use, and lets a script that passes the audit but speaks flat (too few interruptions, reactions,
# cut words) be rewritten too. A chapter then costs hours; a weekend for a whole book is normal.
# The same knob per run: `studiepodcast --quality ...` or the "grondig" checkbox in the web app.
# Values you set yourself below always win over quality mode.
STUDIEPODCAST_QUALITY_MODE=0

# Content plan and lexicon: per section, quotes checked against the source, merged and reviewed
# (pipeline/plan/thorough.py). These are the normal-pass values; quality mode raises them.
STUDIEPODCAST_PLAN_REVIEW_ROUNDS=1
# Short sections are read together up to this many characters per call.
STUDIEPODCAST_PLAN_PART_CHARS=8000
# How often a script the audit blocks is rewritten before it is accepted as it is (CLI: --revise-rounds).
STUDIEPODCAST_REVISE_ROUNDS=1
# Longest episode in minutes. Each episode is as long as its material carries, between 6 and this.
STUDIEPODCAST_TARGET_MINUTES=25

# OpenCode server: the one writing backend. The model itself is configured inside OpenCode
# (opencode.json or the app). Unset means: find the running server via
# ~/.config/opencode/service.json, then the OpenCode desktop app's log, then
# http://127.0.0.1:4096; the password comes from that same file.
OPENCODE_URL=
OPENCODE_PASSWORD=
# provider/id as `studiepodcast doctor` lists them, optionally with #variant.
OPENCODE_MODEL=strata/strata
# A long chapter takes minutes per call; the endpoint is not streaming. Quality mode raises this
# to 3600 so a thinking local model is never cut off mid-answer.
OPENCODE_TIMEOUT=1800

# Local synthesis: Chatterbox V3 on CUDA with faster-whisper for verification and WhisperX for
# word timings. Run `studiepodcast doctor` to see what is actually installed.
STUDIEPODCAST_DEVICE=
CHATTERBOX_WORKERS=
# Where the Chatterbox V3 weights live. Unset: the Hugging Face cache (offline-safe).
# Run once with STUDIEPODCAST_OFFLINE=0 to download them, or drop the files in this folder.
CHATTERBOX_CKPT_DIR=
HF_TOKEN=
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8
# Render cost knobs: fewer takes is the first thing to lower on a laptop.
STUDIEPODCAST_TAKES=3
STUDIEPODCAST_WER_THRESHOLD=0.05

# Storage.
STUDIEPODCAST_DATA_DIR=data
STUDIEPODCAST_CAST_DIR=cast
