# Copy to .env and fill in. Every variable is optional; unset ones fall back to defaults.

# Keep all book content on your own network. With this on: the Claude API and ElevenLabs refuse
# to start, the local LLM must be on a private address, Hugging Face runs from its local cache.
STUDIEPODCAST_OFFLINE=0

# Which LLM writes plans, lexicon, scripts, audits and continuity: anthropic | local.
# Empty: local when STUDIEPODCAST_OFFLINE=1, otherwise anthropic.
STUDIEPODCAST_LLM_BACKEND=

# Claude API (backend anthropic).
ANTHROPIC_API_KEY=
STUDIEPODCAST_LLM_MODEL=claude-opus-5
STUDIEPODCAST_LLM_EFFORT=high

# Local model server (backend local). ollama = Ollama's native API; openai = llama.cpp server,
# vLLM, LM Studio. Another machine on your LAN works too, e.g. http://192.168.1.20:11434.
LOCAL_LLM_API=ollama
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=gemma4:31b
# Tokens. A long chapter needs 65536; the pipeline tells you when a prompt doesn't fit.
LOCAL_LLM_CONTEXT=32768
# Covers a thinking model's reasoning as well as the answer.
LOCAL_LLM_MAX_TOKENS=16384
# Empty: the model's own default. off = answer without reasoning first (faster); on; low/medium/high where supported.
LOCAL_LLM_THINK=
LOCAL_LLM_TIMEOUT=1800
# 0 to skip figure captions. A model that can't read images is detected on Ollama anyway.
LOCAL_LLM_VISION=1
LOCAL_LLM_API_KEY=

# Accent tier (per block, optional; sends script text to ElevenLabs, blocked offline).
ELEVENLABS_API_KEY=

# Local synthesis. Unset means: cuda + 3 workers + faster-whisper on Linux,
# mps + 1 worker + mlx-whisper on an M-series Mac. Run `studiepodcast doctor` to see the result.
PIPER_BIN=piper
PIPER_VOICES_DIR=~/.local/share/piper/voices
STUDIEPODCAST_DEVICE=
CHATTERBOX_WORKERS=
WHISPER_BACKEND=
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Render cost knobs: fewer takes is the first thing to lower on a laptop.
STUDIEPODCAST_TAKES=3
STUDIEPODCAST_WER_THRESHOLD=0.05

# Storage.
STUDIEPODCAST_DATA_DIR=data
STUDIEPODCAST_CAST_DIR=cast
